{
	"name": "supersurkhet-desktop",
	"productName": "SuperSurkhet",
	"version": "1.0.1",
	"description": "SuperSurkhet Desktop App",
	"main": "dist/main.js",
	"scripts": {
		"dev": "tsc && electron .",
		"build": "tsc && electron-builder",
		"build:unsigned:win": "CSC_IDENTITY_AUTO_DISCOVERY=false tsc && electron-builder --win --publish never",
		"build:unsigned:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false tsc && electron-builder --mac --publish never",
		"build:unsigned:linux": "CSC_IDENTITY_AUTO_DISCOVERY=false tsc && electron-builder --linux --publish never",
		"start": "electron .",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [],
	"author": {
		"name": "SuperSurkhet Team",
		"email": "dev@surkhet.app"
	},
	"homepage": "https://github.com/AbhiShake1/supersurkhet",
	"license": "MIT",
	"dependencies": {
		"electron-store": "^8.1.0",
		"electron-updater": "^6.1.7",
		"electron-log": "^5.0.0"
	},
	"devDependencies": {
		"electron": "28.3.3",
		"electron-builder": "^24.9.1",
		"typescript": "^5.3.3"
	}
}
