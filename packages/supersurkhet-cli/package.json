{
  "name": "@supersurkhet/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "supersurkhet": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
