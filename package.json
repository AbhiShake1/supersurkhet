{
  "name": "tanstart-cfpages",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "desktop:build:unsigned:all": "pnpm --filter supersurkhet-desktop build:unsigned:win && pnpm --filter supersurkhet-desktop build:unsigned:mac && pnpm --filter supersurkhet-desktop build:unsigned:linux",
    "desktop:publish:local": "pnpm downloads:sync",
    "downloads:sync": "node scripts/sync-electron-downloads.mjs",
    "test:e2e": "pnpm --filter supersurkhet test:e2e",
    "test:e2e:headed": "pnpm --filter supersurkhet test:e2e:headed",
    "test:e2e:ui": "pnpm --filter supersurkhet test:e2e:ui",
    "ai": "node scripts/copy-chat.js && qwen --resume default-chat -y --experimental-skills"
  },
  "devDependencies": {
    "@qwen-code/qwen-code": "^0.6.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.7.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {},
  "version": "1.0.0"
}
